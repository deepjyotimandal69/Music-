# GEMINI_API_KEY: Required for Gemini AI API calls & Lyria music models.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional: Real AI Music API key (KIE AI / Suno API)
# Can also be configured directly in Personal Settings inside the app
KIE_API_KEY=""

# Optional: Supabase configuration for cloud database and audio storage
# Can also be configured directly in Personal Settings inside the app
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
